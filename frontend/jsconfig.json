{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@sections/*": ["src/sections/*"],
      "@hooks/*": ["src/hooks/*"],
      "@features/*": ["src/features/*"],
      "@lib/queries/*": ["src/features/hotel/queries/*"],
      "@lib/booking/*": ["src/features/hotel/booking/*"],
      "@lib/cart/*": ["src/features/hotel/cart/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@router/*": ["src/router/*"],
      "@assets/*": ["src/assets/*"],
      "@utils/*": ["src/utils/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "include": ["src"]
}
