# Production build — copy this to frontend/.env before `npm run build`.
# Vite bakes every VITE_* value into the built files. Change one, then build again.
# Do not commit frontend/.env.
#
# Local laptop instead:
#   VITE_CMS_URL=http://localhost:3000

# Public origin of Payload. https, no trailing slash.
# The visitor's browser calls this for rooms, bookings, and images.
VITE_CMS_URL=https://cms.beinnvilla.com

# Same-host option: leave this empty when nginx on the website proxies
# /api and media to Payload. The production build then uses the site's own origin.
# VITE_CMS_URL=

# Contact form only. Stay requests are emailed by the backend through Resend.
# Leave these blank unless that contact form is wired to EmailJS.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Leave blank. Website stays are not paid by card in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=
